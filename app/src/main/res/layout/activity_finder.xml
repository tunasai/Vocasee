<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

        <!-- Camera Preview -->
        <FrameLayout
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Menu Button -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="24dp"
            android:background="@drawable/menu"
            android:src="@android:drawable/ic_menu_more"
            android:contentDescription="Menu" />

        <!-- CENTER ANIMATION AREA -->
        <FrameLayout
            android:id="@+id/voiceAnimationContainer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_centerInParent="true">

            <!-- Mic Icon (default state) -->
            <ImageView
                android:id="@+id/btnMicrophone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="@color/white"
                android:clickable="true"
                android:focusable="true" />

            <!-- Speaking Animation (hidden by default) -->
            <LinearLayout
                android:id="@+id/speakingDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <View style="@style/DotStyle"/>
                <View style="@style/DotStyle"/>
                <View style="@style/DotStyle"/>

            </LinearLayout>

        </FrameLayout>

        <!-- Status Text -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_above="@id/voiceAnimationContainer"
            android:layout_marginBottom="24dp"
            android:text="Listening..."
            android:textColor="@color/white"
            android:textSize="18sp" />

    </RelativeLayout>

    <!-- Tutorial Overlay -->
    <LinearLayout
        android:id="@+id/tutorialOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <TextView
            android:text="@string/tutorial_title"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_marginTop="32dp"
            android:text="@string/tutorial_step1"
            android:textColor="@color/gray_light"
            android:textSize="18sp"/>

        <TextView
            android:layout_marginTop="16dp"
            android:text="@string/tutorial_step2"
            android:textColor="@color/gray_light"
            android:textSize="18sp"/>

        <TextView
            android:layout_marginTop="16dp"
            android:text="@string/tutorial_step3"
            android:textColor="@color/gray_light"
            android:textSize="18sp"/>

        <TextView
            android:layout_marginTop="16dp"
            android:text="@string/tutorial_step4"
            android:textColor="@color/gray_light"
            android:textSize="18sp"/>

        <TextView
            android:layout_marginTop="48dp"
            android:text="@string/tap_to_start"
            android:textColor="@color/blue_accent"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>