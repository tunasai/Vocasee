<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Preview (full screen) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Scanning Overlay — dim layer shown while searching -->
    <FrameLayout
        android:id="@+id/scanningContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33000000" />
    </FrameLayout>

    <!-- Status Bar (top) -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="#80000000">

        <View
            android:id="@+id/statusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_white"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_idle"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/tvTargetLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/rounded_box"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/mic_button_bg"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="@string/cd_mic"
            android:padding="24dp"
            android:scaleType="centerInside" />
    </LinearLayout>

    <!-- Detection Box — MUST BE LAST TO BE ON TOP -->
    <View
        android:id="@+id/detectionBox"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:background="@drawable/detection_box_border"
        android:visibility="gone" />

    <!-- Detection Label — MUST BE LAST TO BE ON TOP -->
    <TextView
        android:id="@+id/detectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/blue_accent"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>