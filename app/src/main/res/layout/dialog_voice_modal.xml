<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#22163A"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View android:id="@+id/wave1" style="@style/VoiceWaveBar" />
        <View android:id="@+id/wave2" style="@style/VoiceWaveBar" />
        <View android:id="@+id/wave3" style="@style/VoiceWaveBar" />
        <View android:id="@+id/wave4" style="@style/VoiceWaveBar" />
        <View android:id="@+id/wave5" style="@style/VoiceWaveBar" />
        <View android:id="@+id/wave6" style="@style/VoiceWaveBar" />
        <View android:id="@+id/wave7" style="@style/VoiceWaveBar" />
        <View android:id="@+id/wave8" style="@style/VoiceWaveBar" />
        <View android:id="@+id/wave9" style="@style/VoiceWaveBar" />
        <View android:id="@+id/wave10" style="@style/VoiceWaveBar" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVoiceInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:hint="@string/voice_hint"
        android:text="@string/voice_example_hint"
        android:textColor="#E7E1FF"
        android:textColorHint="#D9D1FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnVoiceCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#00000000"
        android:text="@string/voice_cancel"
        android:textColor="@color/white" />
</LinearLayout>
