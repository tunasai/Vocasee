<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SettingsRow">

    <ImageView
        style="@style/SettingsIcon"
        android:src="@drawable/ic_record_voice_over" />

    <TextView
        style="@style/SettingsText"
        android:text="@string/settings_voice_guide" />

    <TextView
        android:id="@+id/tvVoiceGuideState"
        style="@style/SettingsSwitchState" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchVoiceGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
