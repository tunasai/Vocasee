<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SettingsSliderRow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            style="@style/SettingsIcon"
            android:src="@drawable/ic_format_size" />
        <TextView
            style="@style/SettingsText"
            android:text="@string/settings_text_size" />
        <TextView
            android:id="@+id/tvTextSizeValue"
            style="@style/SettingsValue" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekTextSize"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="38dp"
        android:layout_marginEnd="8dp"
        android:max="100"
        android:progressTint="@color/vocasee_green"
        android:thumbTint="@color/vocasee_green" />
</LinearLayout>
