    <!-- Existing app strings -->
    <string name="app_name">VOCASEE</string>
    <string name="welcome_title">Welcome to\nVOCASEE</string>
    <string name="welcome_description">VOCASEE helps visually impaired users locate selected indoor household items through voice commands, camera-based object detection, audio guidance, haptic feedback, and hand proximity guidance.</string>
    <string name="welcome_title_plain">Welcome to VOCASEE</string>
    <string name="splash_tagline">VOICE - GUIDED. OBJECT. FINDER.</string>
    <string name="splash_loading_model">Loading on-device model...</string>
    <string name="tap_screen_to_start">Tap the screen to start</string>
    <string name="tts_welcome_hub">Welcome to VocaSee. This app helps you find indoor household objects using voice commands, camera detection, audio guidance, vibration, and hand proximity guidance. It currently detects 24 objects. Tap the screen to start.</string>
    <string name="tts_tutorial_complete">Tutorial complete. VocaSee is ready. Tap anywhere or wait to open the camera.</string>
    <string name="welcome_feature_header">Key Features</string>
    <string name="welcome_object_list_header">Supported Objects</string>
    <string name="welcome_object_list_body">Backpack, book, cup, glasses, headset, key, phone, remote, wallet, water bottle, body spray, card, charger, comb, flashlight, glasses case, medicine, nail clipper, shoe, watch, body scrub, cane, lighter, and towel.</string>
    <string name="welcome_recent_header">Recently looked for</string>
    <string name="welcome_feature_body">- Voice command object search\n- Near real-time camera object detection\n- Spoken direction, color, and confidence feedback\n- Haptic radar feedback while approaching objects\n- Hand proximity guidance when your hand is visible</string>
